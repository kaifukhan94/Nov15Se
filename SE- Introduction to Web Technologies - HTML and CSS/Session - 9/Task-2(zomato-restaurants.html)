<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Zomato Restaurant Listing</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f8f9fa;
        }

        .restaurant-card {
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            background-color: white;
            transition: 0.3s;
        }

        .restaurant-card:hover {
            box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.2);
        }

        h2 {
            color: #e23744;
            text-align: center;
            margin: 30px 0;
        }

        h4 {
            color: #333;
        }

        p {
            color: #666;
        }
    </style>
</head>

<body>

    <div class="container">

        <h2>Zomato Restaurant Listings</h2>

        <div class="row">

            <div class="col-6">

                <div class="restaurant-card">

                    <h4>Spice Garden</h4>

                    <p>
                        Famous for North Indian and Chinese cuisine with
                        quick delivery and affordable prices.
                    </p>

                </div>

            </div>

            <div class="col-6">

                <div class="restaurant-card">

                    <h4>Pizza Hub</h4>

                    <p>
                        Delicious pizzas, burgers, pasta, and refreshing
                        beverages for every occasion.
                    </p>

                </div>

            </div>

            <div class="col-6">

                <div class="restaurant-card">

                    <h4>Biryani House</h4>

                    <p>
                        Authentic Hyderabadi Biryani served with rich flavors
                        and fresh ingredients.
                    </p>

                </div>

            </div>

            <div class="col-6">

                <div class="restaurant-card">

                    <h4>Food Junction</h4>

                    <p>
                        Multi-cuisine restaurant offering Indian, Chinese,
                        and Continental dishes.
                    </p>

                </div>

            </div>

        </div>

    </div>

</body>

</html>